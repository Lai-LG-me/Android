@Composable
// BMI = Weight / height*height
fun BMICalculatorApp(){
    var weightInput by remember { mutableStateOf("") }      // UI can update if change
    var heightInput by remember { mutableStateOf("") }
    var result by remember { mutableStateOf("") }


    Column(modifier = Modifier
        .fillMaxSize()
        .padding(16.dp)
        , verticalArrangement = Arrangement.Center
    ) {
        TextField(
            value = weightInput,
            onValueChange = { weightInput = it },
            label = { Text("Enter weight (kg)") }
        )
        TextField(
            value = heightInput,
            onValueChange = { heightInput = it },
            label = { Text("Enter height (m) ") }
        )

        Button(
            onClick ={
                val weight = weightInput.toFloatOrNull() ?: 0f      // cause the input is string, so need tofloat
                val height = heightInput.toFloatOrNull() ?: 1f
                val bmi = weight / (height * height)

               // result = "Your BMI is %.2f".format(BMI)
                result = if (bmi < 18.5){
                    "Your BMI is %.2f   -> Underweight".format(bmi)
                }else if (bmi < 24.9){
                    "Your BMI is %.2f   -> Normal".format(bmi)
                }else if (bmi < 29.9){
                    "Your BMI is %.2f   -> Overweight".format(bmi)
                }else
                    "Your BMI is %.2f   -> Obese".format(bmi)

            }

        ) {
            Text("Calculate")

        }
        Text(
            text = result,
            modifier = Modifier.padding(16.dp))
    }



}

